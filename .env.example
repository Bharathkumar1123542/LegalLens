# LegalLens Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to git (it's in .gitignore)

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://legallens:legallens_dev_password@localhost:5432/legallens

# ─────────────────────────────────────────────────────────────────────────────
# Redis (Cache + Celery Broker)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ─────────────────────────────────────────────────────────────────────────────
# S3 Storage (AWS S3 or MinIO for local dev)
# ─────────────────────────────────────────────────────────────────────────────
S3_BUCKET=legallens-dev
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# For AWS S3 (production), remove S3_ENDPOINT_URL and set real credentials:
# S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
# AWS_DEFAULT_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# API Keys (Required)
# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude API - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Voyage AI API - Get from: https://dash.voyageai.com/
VOYAGE_API_KEY=pa-your-key-here

# ─────────────────────────────────────────────────────────────────────────────
# JWT Secrets (Generate secure random strings)
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ─────────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Options: development, staging, production

DEBUG=true
# Set to false in production

CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated list of allowed origins

# ─────────────────────────────────────────────────────────────────────────────
# Observability (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn-here
# Leave empty to disable Sentry

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ─────────────────────────────────────────────────────────────────────────────
# CAPTCHA (Phase 9 - Bot Prevention)
# ─────────────────────────────────────────────────────────────────────────────
CAPTCHA_ENABLED=true
# Set to false to bypass CAPTCHA (testing/development only)

# CAPTCHA_SECRET_KEY=your-hcaptcha-secret-key-here
# CAPTCHA_SITE_KEY=your-hcaptcha-site-key-here
# Get from: https://dashboard.hcaptcha.com/
# If not set, CAPTCHA will be bypassed in development mode

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60

# ─────────────────────────────────────────────────────────────────────────────
# File Upload Limits
# ─────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ─────────────────────────────────────────────────────────────────────────────
# LLM Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Model IDs (see architecture.md §4 for approved models)
LLM_MODEL_GENERATION=claude-sonnet-4-20250514
LLM_MODEL_CLASSIFICATION=claude-haiku-4-5-20251001
EMBEDDING_MODEL=voyage-context-4
EMBEDDING_DIMENSION=1024

# ─────────────────────────────────────────────────────────────────────────────
# Worker Configuration
# ─────────────────────────────────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=2
# Number of concurrent worker processes

# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose Overrides (for local development)
# ─────────────────────────────────────────────────────────────────────────────
# When using docker-compose, these are overridden in docker-compose.yml:
# DATABASE_URL=postgresql+asyncpg://legallens:legallens_dev_password@postgres:5432/legallens
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT_URL=http://minio:9000
