# Test environment variables — used by pytest only.
# All values are non-secret placeholders for unit/integration tests.
# The DB and S3 calls are patched in tests; these just satisfy the Settings validator.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///:memory:
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
S3_BUCKET=test-bucket
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
ANTHROPIC_API_KEY=test-anthropic-key
VOYAGE_API_KEY=test-voyage-key
JWT_SECRET=test-jwt-secret-256-bits-long-placeholder-value-ok
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG
